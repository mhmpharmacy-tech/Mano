{
  "name": "mano-kid-care-home-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MANO Kid premium RTL Care Home for Google AI Studio Build",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/domain/*.test.ts src/state/*.test.ts src/api/*.test.ts src/navigation/*.test.ts server/*.test.ts server/aiGateway/*.test.ts",
    "test:web": "node --test tests/web.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:web"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "express": "^5.3.0",
    "lucide-react": "^1.80.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "playwright": "1.56.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8"
  }
}
