# Server-side Gemini API Key (never exposed to browser; all deterministic clinical engines work without it)
GEMINI_API_KEY=

# Shared with Firebase: leave false until separate clinical release approval.
# Merely setting GEMINI_API_KEY must never enable public AI access.
MANO_CLINICAL_SERVICE_ENABLED=false

# Trusted server callers only; never use a VITE_ variable or put this in a browser.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Accepted format: 43..256 base64url characters. Empty/invalid fails closed.
# Enabled AI APIs and the audit endpoint require Authorization: Bearer <token>.
# This deployment secret does not authenticate a caregiver or replace Firebase Auth.
MANO_GATEWAY_ACCESS_TOKEN=

# Supported Gemini model identifier (allowlist-validated on server startup)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ALLOWED_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.5-pro,gemini-2.0-flash

# AI Gateway resilience & budget controls
GEMINI_TIMEOUT_MS=25000
GEMINI_MAX_RETRIES=2
GEMINI_RATE_LIMIT_MAX=20
GEMINI_BUDGET_MAX_REQUESTS=400
GEMINI_BUDGET_MAX_CHARS=600000

# Server port (defaults to 3000)
PORT=3000
