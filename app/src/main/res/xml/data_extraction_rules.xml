<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+: both cloud and device-to-device transfers must exclude local child records. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
