<?xml version="1.0" encoding="utf-8"?>
<!-- Disallow cloud backup and device-to-device extraction of child health data. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore" />
        <exclude domain="sharedpref" path="mano_fever_timeline_widget.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore" />
        <exclude domain="sharedpref" path="mano_fever_timeline_widget.xml" />
    </device-transfer>
</data-extraction-rules>
