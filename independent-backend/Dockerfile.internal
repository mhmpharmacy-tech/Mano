# Internal synthetic runtime only. Do not expose ingress or use as the public MANO app.
FROM node:24-bookworm-slim
WORKDIR /srv/mano
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY policy.mjs server.mjs demo-auth.mjs integration-host.mjs ./
USER node
CMD ["node", "integration-host.mjs"]
